{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["DOM", "ESNext"],
    "jsx": "react-jsx",
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@state": ["./src/web/state/index.ts"],
      "@web/*": ["./src/web/*"],
      "@components": ["./src/web/components/index.ts"],
      "@atoms": ["./src/web/components/atoms/index.ts"],
      "@shared/*": ["./src/shared/*"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": true,
        "quickinfo": true,
        "completions": true,
        "refactors": true,
        "diagnosticSeverity": {
          "anyUnknownInErrorContext": "warning",
          "catchUnfailableEffect": "warning",
          "lazyEffect": "warning",
          "leakingRequirements": "warning",
          "preferUnsafeConstructor": "warning",
          "returnEffectInGen": "warning",
          "runEffectInsideEffect": "warning",
          "schemaSyncInEffect": "warning",
          "strictEffectProvide": "warning",
          "tryCatchInEffectGen": "warning",
          "unsafeEffectTypeAssertion": "warning"
        }
      }
    ]
  },
  "include": ["src"]
}
